{
    "scripts": {
        "verify": "pnpm dlx starkscan",
        "initiate:deploy-contracts": "jiti ./scripts/initiate/deployContracts.ts",
        "initiate:grant-roles": "jiti ./scripts/initiate/grantRoles.ts",
        "initiate:config": "jiti ./scripts/initiate/config.ts",
        "initiate": "pnpm run initiate:deploy-contracts && pnpm run initiate:grant-roles",
        "action:create-market": "jiti ./scripts/actions/admin/createMarket.ts",
        "action:create-deposit": "jiti ./scripts/actions/user/createDeposit.ts",
        "action:execute-deposit": "jiti ./scripts/actions/keeper/executeDeposit.ts",
        "action:create-long-order": "jiti ./scripts/actions/user/createLongOrder.ts",
        "action:execute-long-order": "jiti ./scripts/actions/keeper/executeLongOrder.ts",
        "action:create-Swap-order": "jiti ./scripts/actions/user/createSwapOrder.ts",
        "action:execute-Swap-order": "jiti ./scripts/actions/keeper/executeSwapOrder.ts",
        "sepolia:initiate:deploy-contracts": "dotenvx run -f .env.sepolia -- pnpm run initiate:deploy-contracts",
        "sepolia:initiate:grant-roles": "dotenvx run -f .env.sepolia -- pnpm run initiate:grant-roles",
        "sepolia:initiate:config": "dotenvx run -f .env.sepolia -- pnpm run initiate:config",
        "sepolia:initiate": "dotenvx run -f .env.sepolia -- pnpm run initiate",
        "sepolia:action:create-market": "dotenvx run -f .env.sepolia -- pnpm run action:create-market",
        "sepolia:action:create-deposit": "dotenvx run -f .env.sepolia -- pnpm run action:create-deposit",
        "sepolia:action:execute-deposit": "dotenvx run -f .env.sepolia -- pnpm run action:execute-deposit",
        "sepolia:action:create-long-order": "dotenvx run -f .env.sepolia -- pnpm run action:create-long-order",
        "sepolia:action:execute-long-order": "dotenvx run -f .env.sepolia -- pnpm run action:execute-long-order",
        "sepolia:action:create-swap-order": "dotenvx run -f .env.sepolia -- pnpm run action:create-swap-order",
        "sepolia:action:execute-swap-order": "dotenvx run -f .env.sepolia -- pnpm run action:execute-swap-order",
        "main:deploy-contracts": "dotenvx run -f .env.main -- pnpm run deploy-contracts",
        "gen:abis": "jiti ./scripts/gen/genAbis.ts",
        "gen:class-hashes": "jiti ./scripts/gen/genClassHashes.ts",
        "typecheck": "tsc --noEmit"
    },
    "type": "module",
    "dependencies": {
        "@dotenvx/dotenvx": "^1.6.4",
        "jiti": "^1.21.6",
        "starknet": "^6.12.1",
        "typescript": "^5.5.3"
    },
    "packageManager": "pnpm@9.7.0",
    "devDependencies": {
        "@types/node": "^20.14.11",
        "abi-wan-kanabi": "^2.2.2"
    }
}
