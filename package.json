{
    "scripts": {
        "verify": "bun dlx starkscan",
        "deploy": "bun ./scripts/deploy.ts",
        "action:create-market": "bun ./scripts/actions/admin/createMarket.ts",
        "action:config-market": "bun ./scripts/actions/admin/configMarket.ts",
        "action:create-and-config-market": "bun ./scripts/actions/admin/createAndConfigMarket.ts",
        "action:create-deposit": "bun ./scripts/actions/user/createDeposit.ts",
        "action:execute-deposit": "bun ./scripts/actions/keeper/executeDeposit.ts",
        "action:create-withdrawal": "bun ./scripts/actions/user/createWithdrawal.ts",
        "action:create-order": "bun ./scripts/actions/user/createOrder.ts",
        "action:cancel-order": "bun ./scripts/actions/user/cancelOrder.ts",
        "action:execute-order": "bun ./scripts/actions/keeper/executeOrder.ts",
        "action:create-swap-order": "bun ./scripts/actions/user/createSwapOrder.ts",
        "action:execute-liquidation": "bun ./scripts/actions/keeper/executeLiquidation.ts",
        "keeper": "bun ./keeper/src/index.ts",
        "full-flow": "bun action:create-market && bun action:config-market && bun action:create-deposit && bun action:execute-deposit && bun action:create-order && bun action:execute-order",
        "sepolia:deploy": "dotenvx run -f .env.sepolia -- bun run deploy",
        "sepolia:action:create-market": "dotenvx run -f .env.sepolia -- bun run action:create-market",
        "sepolia:action:config-market": "dotenvx run -f .env.sepolia -- bun run action:config-market",
        "sepolia:action:create-and-config-market": "dotenvx run -f .env.sepolia -- bun run action:create-and-config-market",
        "sepolia:action:create-deposit": "dotenvx run -f .env.sepolia -- bun run action:create-deposit",
        "sepolia:action:execute-deposit": "dotenvx run -f .env.sepolia -- bun run action:execute-deposit",
        "sepolia:action:create-withdrawal": "dotenvx run -f .env.sepolia -- bun run action:create-withdrawal",
        "sepolia:action:create-order": "dotenvx run -f .env.sepolia -- bun run action:create-order",
        "sepolia:action:cancel-order": "dotenvx run -f .env.sepolia -- bun run action:cancel-order",
        "sepolia:action:execute-order": "dotenvx run -f .env.sepolia -- bun run action:execute-order",
        "sepolia:action:create-swap-order": "dotenvx run -f .env.sepolia -- bun run action:create-swap-order",
        "sepolia:action:execute-liquidation": "dotenvx run -f .env.sepolia -- bun run action:execute-liquidation",
        "sepolia:keeper": "dotenvx run -f .env.sepolia -- bun run keeper",
        "sepolia:full-flow": "dotenvx run -f.env.sepolia -- bun run full-flow",
        "mainnet:deploy": "dotenvx run -f .env.mainnet -- bun run deploy",
        "gen:abis": "bun ./scripts/gen/genAbis.ts",
        "gen:class-hashes": "bun ./scripts/gen/genClassHashes.ts",
        "gen": "bun run --parallel --aggregate-output --reporter-hide-prefix '/^gen:(.+)$/'",
        "typecheck": "tsc --noEmit",
        "test": "bun ./scripts/test.ts"
    },
    "type": "module",
    "dependencies": {
        "@dotenvx/dotenvx": "^1.6.4",
        "@pythnetwork/hermes-client": "^1.0.4",
        "@sinclair/typebox": "^0.33.9",
        "abi-wan-kanabi": "2.2.2",
        "devalue": "^5.0.0",
        "nanoevents": "^9.0.0",
        "p-retry": "^6.2.0",
        "picocolors": "^1.0.1",
        "pino": "^9.4.0",
        "pino-pretty": "^11.2.2",
        "satoru-sdk": "^1.1.3",
        "starknet": "^6.12.1",
        "typescript": "^5.5.3"
    },
    "devDependencies": {
        "@flydotio/dockerfile": "^0.5.8",
        "@total-typescript/ts-reset": "^0.6.1",
        "@types/bun": "^1.1.8",
        "type-fest": "^4.26.0"
    }
}
