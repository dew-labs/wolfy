{
    "scripts": {
        "verify": "pnpm dlx starkscan",
        "deploy": "bun ./scripts/deploy.ts",
        "action:create-market": "bun ./scripts/actions/admin/createMarket.ts",
        "action:config-market": "bun ./scripts/actions/admin/configMarket.ts",
        "action:create-deposit": "bun ./scripts/actions/user/createDeposit.ts",
        "action:execute-deposit": "bun ./scripts/actions/keeper/executeDeposit.ts",
        "action:create-order": "bun ./scripts/actions/user/createOrder.ts",
        "action:cancel-order": "bun ./scripts/actions/user/cancelOrder.ts",
        "action:execute-order": "bun ./scripts/actions/keeper/executeOrder.ts",
        "action:create-swap-order": "bun ./scripts/actions/user/createSwapOrder.ts",
        "keeper": "bun ./keeper/src/index.ts",
        "full-flow": "pnpm action:create-market && pnpm action:config-market && pnpm action:create-deposit && pnpm action:execute-deposit && pnpm action:create-order && pnpm action:execute-order",
        "sepolia:deploy": "dotenvx run -f .env.sepolia -- pnpm run deploy",
        "sepolia:action:create-market": "dotenvx run -f .env.sepolia -- pnpm run action:create-market",
        "sepolia:action:config-market": "dotenvx run -f .env.sepolia -- pnpm run action:config-market",
        "sepolia:action:create-deposit": "dotenvx run -f .env.sepolia -- pnpm run action:create-deposit",
        "sepolia:action:execute-deposit": "dotenvx run -f .env.sepolia -- pnpm run action:execute-deposit",
        "sepolia:action:create-order": "dotenvx run -f .env.sepolia -- pnpm run action:create-order",
        "sepolia:action:cancel-order": "dotenvx run -f .env.sepolia -- pnpm run action:cancel-order",
        "sepolia:action:execute-order": "dotenvx run -f .env.sepolia -- pnpm run action:execute-order",
        "sepolia:action:create-swap-order": "dotenvx run -f .env.sepolia -- pnpm run action:create-swap-order",
        "sepolia:keeper": "dotenvx run -f .env.sepolia -- pnpm run keeper",
        "sepolia:full-flow": "dotenvx run -f.env.sepolia -- pnpm run full-flow",
        "mainnet:deploy": "dotenvx run -f .env.mainnet -- pnpm run deploy",
        "gen:abis": "bun ./scripts/gen/genAbis.ts",
        "gen:class-hashes": "bun ./scripts/gen/genClassHashes.ts",
        "gen": "pnpm run --parallel --aggregate-output --reporter-hide-prefix '/^gen:(.+)$/'",
        "typecheck": "tsc --noEmit",
        "test": "bun ./scripts/test.ts"
    },
    "type": "module",
    "dependencies": {
        "@dotenvx/dotenvx": "^1.6.4",
        "@pythnetwork/hermes-client": "^1.0.4",
        "abi-wan-kanabi": "^2.2.2",
        "picocolors": "^1.0.1",
        "satoru-sdk": "^1.0.6",
        "starknet": "^6.12.1",
        "typescript": "^5.5.3"
    },
    "packageManager": "pnpm@9.5.0+sha512.140036830124618d624a2187b50d04289d5a087f326c9edfc0ccd733d76c4f52c3a313d4fc148794a2a9d81553016004e6742e8cf850670268a7387fc220c903",
    "devDependencies": {
        "@flydotio/dockerfile": "^0.5.8",
        "@types/node": "^20.14.11"
    }
}
